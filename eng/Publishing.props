<Project>

  <!--
    The Native AOT `darc` tool ships as one package per runtime identifier, and ILCompiler cannot
    compile across operating systems, so CI builds each of those packages in a job of its own on an
    agent of the matching OS. Those jobs build the whole repository just like every other job, which
    is what makes them a build check for their platform as well, but every artifact apart from their
    own darc package is already published by the RID-agnostic job.

    EnableDefaultRidSpecificArtifacts narrows Arcade's default artifact globs to packages carrying
    the target RID in their name, which here leaves exactly Microsoft.DotNet.Darc.<rid>.*.nupkg.
  -->
  <PropertyGroup Condition="'$(DarcToolRuntimeIdentifier)' != ''">
    <TargetRid>$(DarcToolRuntimeIdentifier)</TargetRid>
    <EnableDefaultRidSpecificArtifacts>true</EnableDefaultRidSpecificArtifacts>
  </PropertyGroup>

</Project>
