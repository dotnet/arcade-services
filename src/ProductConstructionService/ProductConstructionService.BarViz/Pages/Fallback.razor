@page "/{*Path}"
@layout MainLayout
@inject NavigationManager NavigationManager

@* Preserve the old SPA fallback for direct client-route requests and legacy URL redirects. *@

<PageTitle>Not found</PageTitle>

<p role="alert">Sorry, there's nothing at this address.</p>

@code {
    [Parameter]
    public string? Path { get; set; }

    protected override void OnInitialized()
    {
        string? newLocation = UrlRedirectManager.ApplyLocationRedirects(NavigationManager.Uri);
        if (!string.IsNullOrEmpty(newLocation)
            && !string.Equals(newLocation, NavigationManager.Uri, StringComparison.OrdinalIgnoreCase))
        {
            NavigationManager.NavigateTo(newLocation, replace: true);
        }
    }
}
